# Пример настроек backend. Скопируйте в .env и вставьте свои ключи.
# Без ключей ИИ отвечает встроенными точными ответами (демо работает офлайн).
AI_FUNPAY_BASE_URL=https://www.ai-funpay.ru/v1
AI_FUNPAY_KEY=
AI_MODEL=gpt-6-astra
POLLINATIONS_API_KEY=
POLLI_MODEL=openai
# Купленный ключ (DungeonAPI, OpenAI-compatible) — основной провайдер
# для ИИ-аналитика и ИИ-консультанта. Ключ — только в .env, НЕ в git.
DUNGEON_BASE_URL=https://31-76-100-137.sslip.io/v1
DUNGEON_API_KEY=
DUNGEON_MODEL=gpt-6-astra
AI_MAX_TOKENS=350
